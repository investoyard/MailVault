# Copy to .env and fill in. Never commit .env.

# Dedicated database on the existing Postgres server (port 5433).
# Create it once with: powershell -ExecutionPolicy Bypass -File scripts\setup-db.ps1 -SuperUser postgres
DATABASE_URL="postgresql://mailvault:CHANGE_ME@127.0.0.1:5433/mailvault?schema=public"

# API (served to users through IIS)
PORT=3200
HOST=127.0.0.1
COOKIE_SECURE=false

# Generate with: npm run gen-keys
# SECRET_ENC_KEY encrypts stored refresh tokens/secrets. Losing it means mailboxes must be re-authorized.
JWT_SECRET=
SECRET_ENC_KEY=

# Business time zone for date folders and dashboard "today"
BUSINESS_TIMEZONE=Asia/Kolkata

# ---- Microsoft 365 (Entra ID app registration, see docs/ENTRA-SETUP.md) ----
M365_TENANT_ID=
M365_CLIENT_ID=
# Preferred: certificate (PEM file containing private key + certificate)
M365_CERT_PATH=
# Fallback for first tests only: client secret
M365_CLIENT_SECRET=

# ---- Worker ----
WORKER_HEARTBEAT_SECONDS=30
LOG_LEVEL=info
