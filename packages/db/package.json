{
  "name": "@mailvault/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "seed-demo": "dotenv -e ../../.env -- tsx src/seed-demo.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@mailvault/shared": "0.1.0",
    "@prisma/client": "^6.19.3",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.3"
  }
}
